; Engine configuration file.
; ПОСЛЕДНИЙ ИСТОЧНИК: Waifu Uprising — кооперативный 3D action roguelite.
; Godot 4.7.2 stable, GDScript (typed), ENet high-level multiplayer.

config_version=5

[application]

config/name="ПОСЛЕДНИЙ ИСТОЧНИК: Waifu Uprising"
config/description="Кооперативный 3D action roguelite (1-8 игроков): защитите Гигачада — последний источник энергии резонанса — от Ордена Гламура."
config/version="0.2.0-stage2"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
Classes="*res://scripts/autoload/class_registry.gd"
Content="*res://scripts/autoload/content_registry.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Net="*res://scripts/autoload/net_manager.gd"
Game="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

